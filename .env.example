# Copy to .env and fill in what you have. Every key is optional; Settings shows which ones are active.
# Search mix: ~half of all searches go to company career sites (free, no key). The rest is split between
# LinkedIn (Apify), Naukri/Indeed (Firecrawl) and other portals (JSearch, Adzuna, Jooble).

# --- LinkedIn jobs: Apify (free plan = $5 usage a month, no card). https://console.apify.com/settings/integrations
APIFY_TOKEN=

# --- Naukri + Indeed pages, and finding HR / hiring-team people: Firecrawl (free = 1,000 credits). https://firecrawl.dev
FIRECRAWL_API_KEY=

# --- Other portals (Glassdoor, Shine, Foundit...): JSearch on RapidAPI (free = 200 searches a month)
RAPIDAPI_KEY=
# Adzuna India, free key, no card: https://developer.adzuna.com/
ADZUNA_APP_ID=
ADZUNA_APP_KEY=
# Jooble, free key (500 requests in total): https://jooble.org/api/about
JOOBLE_API_KEY=

# --- Sending emails and tracking replies. Gmail needs an App Password: https://myaccount.google.com/apppasswords
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
IMAP_HOST=imap.gmail.com
FROM_NAME=

# --- Optional extras
ANTHROPIC_API_KEY=
HUNTER_API_KEY=
APOLLO_API_KEY=
